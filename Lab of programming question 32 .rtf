\f0\fs24 \cf0 #include <iostream>\
\
template<class T>\
class Set \{\
public:\
    // Default constructor to make the set empty\
    Set() : count(0) \{\}\
\
    // Copy constructor\
    Set(const Set<T>& other) \{\
        count = other.count;\
        for (int i = 0; i < count; ++i) \{\
            element[i] = other.element[i];\
        \}\
    \}\
\
    // Function member to add an element of type T to the set\
    int add(const T& value) \{\
        // Check if the element already exists in the set\
        for (int i = 0; i < count; ++i) \{\
            if (element[i] == value) \{\
                // If element already exists, return 0 (no elements added)\
                return 0;\
            \}\
        \}\
        // Add the element to the set\
        element[count++] = value;\
        // Return the number of elements added (1)\
        return 1;\
    \}\
\
    // Function member to add all elements from another set\
    int add(const Set<T>& other) \{\
        int added = 0;\
        for (int i = 0; i < other.count; ++i) \{\
            added += add(other.element[i]);\
        \}\
        return added;\
    \}\
\
    void display() \{\
        for (int j = 0; j < count; j++)\
            std::cout << element[j] << " ";\
    \}\
\
private:\
    T element[100]; // Array to store elements\
    int count;      // Number of elements in the set\
\};\
\
}