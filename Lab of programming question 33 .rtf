\f0\fs24 \cf0 #include <iostream>\
#include <set>\
\
// Template class for a Set data structure\
template<class T>\
class Set \{\
public:\
    // Default constructor\
    Set() \{\}\
\
    // Copy constructor\
    Set(const Set<T>& other) : elements(other.elements) \{\}\
\
    // Method to add a single element to the set\
    // Returns 1 if the element is added, 0 if it's already present\
    int add(const T& elementToAdd) \{ return elements.insert(elementToAdd).second ? 1 : 0; \}\
\
    // Method to add all elements of another set to this set\
    // Returns the count of elements added\
    int add(const Set<T>& otherSet) \{\
        int addedCount = 0;\
        for (const T& element : otherSet.elements) \{\
            if (add(element) == 1)\
                addedCount++;\
        \}\
        return addedCount;\
    \}\
\
    // Method to display all elements of the set\
    void display() const \{\
        for (const T& element : elements)\
            std::cout << element << " ";\
    \}\
\
    // Overloaded operator+ to perform set union\
    Set<T> operator+(const Set<T>& otherSet) const \{\
        Set<T> resultSet(*this);\
        resultSet.add(otherSet);\
        return resultSet;\
    \}\
\
    // Overloaded operator- to perform set difference\
    Set<T> operator-(const Set<T>& otherSet) const \{\
        Set<T> resultSet;\
        for (const T& element : elements) \{\
            if (otherSet.elements.find(element) != otherSet.elements.end())\
                resultSet.add(element);\
        \}\
        return resultSet;\
    \}\
\
private:\
    std::set<T> elements; // Underlying set container to hold elements\
\};}